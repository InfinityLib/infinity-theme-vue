#!/usr/bin/env bash
# Pre-commit hook: format and lint what is staged, before it lands.
#
# Install once per clone:
#   bash scripts/install-hooks.sh
#   # or: git config core.hooksPath .githooks
#
# adapt: keep only the block for this project's stack, and delete the others.
# adapt: a hook must never be bypassed (`--no-verify` is forbidden, see the
#        safety rule), so it has to stay fast enough to run on every commit: it
#        checks, it does not run the test suite.
set -euo pipefail

staged() {
    git diff --cached --name-only --diff-filter=ACMR | grep -E "$1" || true
}

# A missing tool must neither block every commit nor pass unnoticed: warn, skip
# the block, and let the commit through. Blocking here is how people learn to
# reach for `--no-verify`.
have() {
    if command -v "$1" >/dev/null 2>&1; then
        return 0
    fi
    printf '\n  %s is not installed: %s skipped.\n' "$1" "$2" >&2
    return 1
}

# --- Rust -------------------------------------------------------------------
rs_files="$(staged '\.rs$')"
if [ -n "$rs_files" ] && have rustfmt "formatting the staged Rust files"; then
    # adapt: keep --edition in step with Cargo.toml (2015, 2018, 2021, 2024).
    # shellcheck disable=SC2086
    rustfmt --edition 2021 $rs_files
    # Formatting rewrites the working tree; the index still holds the old bytes.
    # shellcheck disable=SC2086
    git add -- $rs_files
fi
if [ -n "$rs_files" ] && have cargo "linting the crate"; then
    cargo clippy --all-targets --quiet -- -D warnings
fi

# --- PHP --------------------------------------------------------------------
php_files="$(staged '\.php$')"
if [ -n "$php_files" ] && have vendor/bin/pint "formatting the staged PHP files"; then
    vendor/bin/pint --dirty
    # shellcheck disable=SC2086
    git add -- $php_files
fi

# --- JavaScript / TypeScript ------------------------------------------------
js_files="$(staged '\.(js|ts|vue)$')"
if [ -n "$js_files" ] && have bunx "linting the staged JS/TS files"; then
    # shellcheck disable=SC2086
    bunx --bun oxlint --fix $js_files
    # shellcheck disable=SC2086
    git add -- $js_files
fi

# --- Shell ------------------------------------------------------------------
sh_files="$(staged '\.sh$')"
if [ -n "$sh_files" ] && have shellcheck "checking the staged shell scripts"; then
    # shellcheck disable=SC2086
    shellcheck $sh_files
fi
