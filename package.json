{
  "name": "@infinitylib/infinity-theme-vue",
  "version": "0.1.0",
  "description": "Vue wrappers for the infinity-theme classes: props and v-model mapped to it-* classes, no styles.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InfinityLib/infinity-theme-vue.git"
  },
  "author": "FortyTwo_Dev",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "vue-tsc -p tsconfig.build.json && vite build",
    "test": "vitest run",
    "type-check": "vue-tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write src/ *.config.ts eslint.config.js",
    "check": "bun run lint && bun run type-check && bun run test && bun run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "eslint-plugin-vuejs-accessibility": "2.6.3",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "vue": "3.5.44",
    "vue-tsc": "3.3.14"
  }
}
